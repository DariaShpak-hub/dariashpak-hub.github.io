---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="About — Daria Shpak"
  description="Senior Graphic Designer specialising in publications and visual communication."
>
  <section class="content-shell py-12 space-y-12">
    <div class="space-y-3 max-w-3xl">
      <p class="eyebrow m-0">About</p>
      <h1 class="text-4xl md:text-5xl font-bold leading-tight text-ink m-0">Daria <span class="font-serif font-normal italic text-accent">Shpak</span></h1>
      <p class="text-muted text-lg">Senior Graphic Designer · Publications & Visual Communication · Norrköping, Sweden</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 max-w-4xl">
      <div class="space-y-4">
        <p class="text-ink text-xl font-semibold leading-snug m-0">Senior Graphic Designer from Ukraine with <span class="serif-highlight">10 years of experience</span> in editorial design, print production, and visual systems across academic and commercial environments.</p>
        <p class="text-muted m-0">Specialized in <span class="serif-highlight">long-format publications</span>, research-based materials, and structured brand communication. Experienced in full production cycles — from concept development to print-ready delivery and coordination with printing houses.</p>
        <p class="text-muted m-0">My approach is systematic. I prioritize <span class="serif-highlight">hierarchy</span>, <span class="serif-highlight">consistency</span>, and <span class="serif-highlight">clarity</span>.</p>
      </div>
      <div class="space-y-4">
        <div class="rounded-[20px] border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-6 space-y-4">
          <p class="eyebrow m-0">Skills & Tools</p>
          <ul class="space-y-2 m-0 list-none p-0">
            {[
              'Adobe InDesign — long-document production',
              'Adobe Illustrator — brand & identity systems',
              'Adobe Photoshop — retouching & compositing',
              'Adobe Premiere Pro — video editing',
              'Adobe After Effects — motion graphics',
              'Figma — UI & web design',
              'Blender — 3D visualisation',
              'Canva, WordPress',
            ].map((skill) => (
              <li class="text-sm text-muted flex items-start gap-2">
                <span class="text-ink mt-0.5">—</span>
                <span>{skill}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="space-y-6 max-w-4xl">
      <p class="eyebrow m-0">Work Domains</p>
      <div class="grid gap-4 sm:grid-cols-3">
        {[
          {
            title: 'Academia',
            description: 'Book covers, full editorial layouts, research catalogues, conference materials, visual identity systems for academic collaborations.',
          },
          {
            title: 'Commerce',
            description: 'Brand systems, web and UI design, packaging, marketing campaigns, professional retouching for commercial clients.',
          },
          {
            title: 'Social & Volunteering',
            description: 'Visual identity and content systems for community organisations and educational social media platforms.',
          },
        ].map(({ title, description }) => (
          <div class="rounded-[20px] border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5 space-y-2">
            <h3 class="font-semibold text-ink m-0">{title}</h3>
            <p class="text-sm text-muted m-0">{description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="space-y-4 max-w-2xl">
      <p class="eyebrow m-0">Contact</p>
      <div class="flex flex-wrap gap-3">
        <a class="button primary" href="mailto:dpolaroid@gmail.com">dpolaroid@gmail.com</a>
        <a class="button secondary" href="https://linkedin.com/in/daria-shpak" target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </div>
  </section>
</PageLayout>
