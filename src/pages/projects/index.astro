---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Card from '../../components/Card.astro';
import { getSite } from '../../utils/consts';
import { withBase } from '../../utils/slugify';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const site = await getSite();

const categories = ['All', ...new Set(projects.flatMap((p) => p.data.tags ?? []))];
---

<PageLayout title={`Projects · ${site.title}`} description="Selected work across editorial design, brand identity, and visual communication.">
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-2 max-w-2xl">
			<p class="eyebrow m-0">Selected Work</p>
			<h1 class="text-4xl font-semibold text-ink m-0">Projects</h1>
			<p class="text-muted m-0">
				Editorial design, brand identity, and visual systems across academic and commercial environments.
			</p>
		</header>

		<div class="flex gap-10 items-start">

			<!-- Left sidebar: filter buttons -->
			<aside class="hidden md:flex flex-col gap-1.5 shrink-0 w-40 sticky top-[calc(var(--grid-cell)*1.5)]" id="filter-bar">
				{categories.map((cat) => (
					<button
						class="filter-btn"
						data-filter={cat === 'All' ? 'all' : cat}
						aria-pressed={cat === 'All' ? 'true' : 'false'}
					>
						{cat}
					</button>
				))}
			</aside>

			<!-- Mobile filter bar -->
			<div class="flex md:hidden flex-wrap gap-2 w-full" id="filter-bar-mobile">
				{categories.map((cat) => (
					<button
						class="filter-btn button"
						data-filter={cat === 'All' ? 'all' : cat}
						aria-pressed={cat === 'All' ? 'true' : 'false'}
					>
						{cat}
					</button>
				))}
			</div>

			<!-- Project grid -->
			{projects.length === 0 ? (
				<p class="text-muted">No projects published yet.</p>
			) : (
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 flex-1 min-w-0" id="projects-grid">
					{projects.map((project) => (
						<div data-tags={JSON.stringify(project.data.tags ?? [])}>
							<Card
								title={project.data.title}
								href={withBase(`/projects/${project.id}/`)}
								image={project.data.heroImage}
								imageAlt={project.data.title}
								description={project.data.description}
								eyebrow={project.data.tags?.[0]}
							/>
						</div>
					))}
				</div>
			)}

		</div>
	</section>
</PageLayout>

<style>
	.filter-btn {
		display: block;
		width: 100%;
		text-align: left;
		padding: 0.4rem 0.75rem;
		border-radius: 8px;
		border: none;
		background: transparent;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--color-muted);
		cursor: pointer;
		transition: color 120ms ease, background 120ms ease;
	}

	.filter-btn:hover {
		color: var(--color-ink);
		background: color-mix(in oklab, var(--color-ink) 6%, transparent);
	}

	.filter-btn[aria-pressed='true'] {
		color: var(--color-accent);
		font-weight: 600;
		background: color-mix(in oklab, var(--color-accent) 10%, transparent);
	}

	/* Mobile filter buttons keep the .button pill style */
	#filter-bar-mobile .filter-btn {
		width: auto;
		text-align: center;
		padding: 0.65rem 1.1rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: color-mix(in oklab, var(--color-surface) 92%, transparent);
		font-weight: 600;
		text-transform: uppercase;
	}

	#filter-bar-mobile .filter-btn[aria-pressed='true'] {
		background: var(--color-accent);
		color: #fff;
		border-color: var(--color-accent);
	}
</style>

<script>
	function initFilters(barId: string, gridId: string) {
		const bar = document.getElementById(barId);
		const grid = document.getElementById(gridId);
		if (!bar || !grid) return;

		bar.addEventListener('click', (e) => {
			const btn = (e.target as Element).closest<HTMLButtonElement>('.filter-btn');
			if (!btn) return;

			const filter = btn.dataset.filter ?? 'all';

			bar.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((b) => {
				b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
			});

			grid.querySelectorAll<HTMLDivElement>('[data-tags]').forEach((card) => {
				const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
				const show = filter === 'all' || tags.includes(filter);
				card.style.display = show ? '' : 'none';
			});
		});
	}

	initFilters('filter-bar', 'projects-grid');
	initFilters('filter-bar-mobile', 'projects-grid');
</script>
