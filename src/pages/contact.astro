---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Contact — Daria Shpak" description="Get in touch with Daria Shpak, Senior Graphic Designer.">
  <section class="content-shell py-12 space-y-10">
    <div class="space-y-2 max-w-2xl">
      <p class="eyebrow m-0">Contact</p>
      <h1 class="text-4xl font-semibold text-ink m-0">Get in touch</h1>
      <p class="text-muted">Available for freelance projects, collaborations, and full-time opportunities.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 max-w-xl">
      <a
        href="mailto:daria.shpak92@gmail.com"
        class="group flex flex-col gap-2 rounded-[20px] border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-6 transition duration-200 hover:-translate-y-1"
      >
        <p class="eyebrow m-0">Email</p>
        <p class="font-semibold text-ink m-0 group-hover:underline">daria.shpak92@gmail.com</p>
      </a>
      <a
        href="https://linkedin.com/in/daria-shpak"
        target="_blank"
        rel="noreferrer"
        class="group flex flex-col gap-2 rounded-[20px] border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-6 transition duration-200 hover:-translate-y-1"
      >
        <p class="eyebrow m-0">LinkedIn</p>
        <p class="font-semibold text-ink m-0 group-hover:underline">daria-shpak</p>
      </a>
    </div>
  </section>
</PageLayout>
