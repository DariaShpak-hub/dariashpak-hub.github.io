---
const tools = [
  { name: 'Adobe InDesign',    icon: 'indesign.png',                              level: 'Expert' },
  { name: 'Adobe Illustrator', icon: 'illustrator.png',                           level: 'Expert' },
  { name: 'Adobe Photoshop',   icon: 'photoshop.png',                             level: 'Expert' },
  { name: 'Adobe Premiere',    icon: 'premiere-pro.png',                          level: 'Advanced' },
  { name: 'After Effects',     icon: 'after-effects.png',                         level: 'Advanced' },
  { name: 'Adobe Lightroom',   icon: 'photoshop-lightroom.png',                   level: 'Advanced' },
  { name: 'Figma',             icon: 'figma.png',                                 level: 'Advanced' },
  { name: 'Blender',           icon: 'blender-1-logo-black-and-white.png',        level: 'Intermediate' },
  { name: 'WordPress',         icon: 'wordpress-logo.png',                        level: 'Proficient' },
  { name: 'Canva',             icon: 'canva-sn23h934yty8bmx8lpihn.webp',          level: 'Proficient' },
];

const levelColor: Record<string, string> = {
  'Expert':       'var(--color-accent)',
  'Advanced':     'var(--color-ink)',
  'Intermediate': 'var(--color-muted)',
  'Proficient':   'var(--color-muted)',
};
---

<section class="content-shell py-16 border-t border-[color:var(--color-border)]">
  <div class="space-y-8">
    <header class="space-y-1">
      <p class="eyebrow m-0">Toolbox</p>
      <h2 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink m-0">
        Software &amp; <span class="font-serif font-normal italic text-accent">Skills</span>
      </h2>
    </header>

    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-3 sm:gap-4">
      {tools.map((tool) => (
        <div class="skill-card-wrapper">
          <div class="skill-card">

            <!-- Front: icon -->
            <div class="skill-face skill-front">
              <img
                src={`/icons/${tool.icon}`}
                alt={tool.name}
                width="48"
                height="48"
                class="skill-icon"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
              />
              <!-- Fallback initials shown if icon missing -->
              <span class="skill-fallback" style="display:none">
                {tool.name.split(' ').map(w => w[0]).join('').slice(0,2)}
              </span>
            </div>

            <!-- Back: name + level -->
            <div class="skill-face skill-back">
              <span class="skill-name">{tool.name}</span>
              <span class="skill-level" style={`color: ${levelColor[tool.level]}`}>{tool.level}</span>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skill-card-wrapper {
    perspective: 700px;
  }

  .skill-card {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: default;
  }

  .skill-card-wrapper:hover .skill-card {
    transform: rotateY(180deg);
  }

  .skill-face {
    position: absolute;
    inset: 0;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem;
  }

  .skill-front {
    background: var(--color-surface);
  }

  .skill-icon {
    width: clamp(32px, 5vw, 52px);
    height: clamp(32px, 5vw, 52px);
    object-fit: contain;
    filter: grayscale(1);
  }

  .skill-fallback {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 700;
    color: var(--color-muted);
    align-items: center;
    justify-content: center;
  }

  .skill-back {
    background: var(--color-ink);
    transform: rotateY(180deg);
    gap: 0.5rem;
  }

  .skill-name {
    font-size: clamp(0.6rem, 1.2vw, 0.75rem);
    font-weight: 600;
    text-align: center;
    line-height: 1.2;
    color: var(--color-paper);
    letter-spacing: 0.02em;
  }

  .skill-level {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.6rem, 1vw, 0.7rem);
    text-align: center;
  }

  /* Dark theme: light grey card fronts so icons are visible */
  :root[data-theme="dark"] .skill-front {
    background: #d4d4d4;
  }
  :root[data-theme="dark"] .skill-icon {
    filter: grayscale(1) invert(0);
  }

  /* In light theme the back is dark ink — keep text readable */
  :root[data-theme="light"] .skill-back {
    background: #111;
  }
  :root[data-theme="light"] .skill-name {
    color: #f5f5f5;
  }
</style>
