---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Prose from '../components/Prose.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	Content?: any;
	tags?: string[];
	gallery?: string[];
}

const { title, description, pubDate, updatedDate, heroImage, tags = [], Content, gallery = [] } = Astro.props as Props;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<div class="flex-1 flex flex-col py-12 md:py-16 lg:py-20 space-y-16">
	<article class="post-page max-w-4xl w-full mx-auto">
		<header class="section-heading">
			<p class="eyebrow">Project</p>
			<h1>{title}</h1>
			<p class="post-meta">
				<FormattedDate date={pubDate} />
				{updatedDate && (
					<span>&middot; Updated <FormattedDate date={updatedDate} /></span>
				)}
			</p>
			{tags.length > 0 && (
				<ul class="mt-2 flex flex-wrap gap-2 text-sm text-muted">
					{tags.map((tag) => (
						<li class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] px-3 py-1">
							{tag}
						</li>
					))}
				</ul>
			)}
		</header>

		{heroImage && (
			<figure class="post-hero-image">
				<Image width={1020} height={510} src={heroImage} alt="" />
			</figure>
		)}

		<section class="post-article">
			<Prose>
				{Content ? <Content /> : <slot />}
			</Prose>
		</section>

		{gallery.length > 0 && (
			<section class="mt-16 space-y-6">
				<h2 class="text-xl font-semibold text-ink m-0">Gallery</h2>
				<div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="gallery-grid">
					{gallery.map((src, i) => (
						<button
							class="gallery-thumb group aspect-square overflow-hidden rounded-[16px] border border-[color:var(--color-border)] bg-[color:var(--color-surface)] cursor-zoom-in focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)]"
							data-index={i}
							aria-label={`Open image ${i + 1}`}
						>
							<img
								src={src}
								alt=""
								loading="lazy"
								class="w-full h-full object-cover transition duration-300 group-hover:scale-[1.04]"
							/>
						</button>
					))}
				</div>
			</section>
		)}
	</article>
	</div>

	<!-- Lightbox -->
	{gallery.length > 0 && (
		<div
			id="lightbox"
			class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm"
			role="dialog"
			aria-modal="true"
			aria-label="Image viewer"
		>
			<button id="lb-close" class="lb-btn absolute top-4 right-4" aria-label="Close">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
			</button>

			<button id="lb-prev" class="lb-btn absolute left-4 top-1/2 -translate-y-1/2" aria-label="Previous image">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
			</button>

			<button id="lb-next" class="lb-btn absolute right-4 top-1/2 -translate-y-1/2" aria-label="Next image">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
			</button>

			<img id="lb-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain rounded-lg select-none" />

			<p id="lb-counter" class="absolute bottom-4 left-1/2 -translate-x-1/2 text-sm text-white/60 tabular-nums"></p>
		</div>
	)}
</BaseLayout>

<style>
	.lb-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid rgba(255,255,255,0.2);
		background: rgba(255,255,255,0.1);
		color: white;
		cursor: pointer;
		transition: background 150ms ease;
	}
	.lb-btn:hover {
		background: rgba(255,255,255,0.22);
	}
	#lightbox.open {
		display: flex;
	}
</style>

<script>
	const images: string[] = JSON.parse(document.getElementById('gallery-grid')?.dataset.images ?? '[]');

	// Pass images array via data attribute on the grid
	const grid = document.getElementById('gallery-grid');
	const lightbox = document.getElementById('lightbox');
	const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
	const lbCounter = document.getElementById('lb-counter');
	const lbClose = document.getElementById('lb-close');
	const lbPrev = document.getElementById('lb-prev');
	const lbNext = document.getElementById('lb-next');

	if (!grid || !lightbox || !lbImg) throw new Error();

	// Collect srcs from the rendered thumbnails
	const srcs = Array.from(grid.querySelectorAll<HTMLImageElement>('img')).map((img) => img.src);
	let current = 0;

	function show(index: number) {
		current = (index + srcs.length) % srcs.length;
		lbImg!.src = srcs[current];
		if (lbCounter) lbCounter.textContent = `${current + 1} / ${srcs.length}`;
	}

	function open(index: number) {
		show(index);
		lightbox.classList.add('open');
		document.body.style.overflow = 'hidden';
		lbImg!.focus();
	}

	function close() {
		lightbox.classList.remove('open');
		document.body.style.overflow = '';
	}

	grid.addEventListener('click', (e) => {
		const btn = (e.target as Element).closest<HTMLButtonElement>('.gallery-thumb');
		if (!btn) return;
		open(Number(btn.dataset.index ?? 0));
	});

	lbClose?.addEventListener('click', close);
	lbPrev?.addEventListener('click', () => show(current - 1));
	lbNext?.addEventListener('click', () => show(current + 1));

	lightbox.addEventListener('click', (e) => {
		if (e.target === lightbox) close();
	});

	document.addEventListener('keydown', (e) => {
		if (!lightbox.classList.contains('open')) return;
		if (e.key === 'Escape') close();
		if (e.key === 'ArrowLeft') show(current - 1);
		if (e.key === 'ArrowRight') show(current + 1);
	});
</script>
